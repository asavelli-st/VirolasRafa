@model FiltrosListado
<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-md">
        <label for="buscar" class="visually-hidden">Buscar</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
            <input type="search" id="buscar" name="buscar" value="@Model.Buscar" class="form-control" placeholder="@Model.Placeholder" autocomplete="off" />
        </div>
    </div>
    @if (Model.Estado is not null)
    {
        <div class="col-8 col-md-auto">
            <label for="estado" class="visually-hidden">Estado</label>
            <select id="estado" name="estado" class="form-select" onchange="this.form.submit()">
                <option value="@EstadoListado.Activos" selected="@(Model.Estado == EstadoListado.Activos)">Activos</option>
                <option value="@EstadoListado.Inactivos" selected="@(Model.Estado == EstadoListado.Inactivos)">Inactivos</option>
                <option value="@EstadoListado.Todos" selected="@(Model.Estado == EstadoListado.Todos)">Todos</option>
            </select>
        </div>
    }
    <div class="col col-md-auto d-grid">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>
