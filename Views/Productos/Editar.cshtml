@model ProductoFormViewModel
@{
    ViewData["Title"] = "Editar producto";
}
<h1 class="h3 mb-3">Editar producto</h1>
<div class="card" style="max-width: 820px">
    <div class="card-body">
        <form asp-action="Editar" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <p class="small text-body-secondary mt-3 mb-0">Los cambios de precio no modifican los presupuestos ya guardados.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto-form.js" asp-append-version="true"></script>
}
