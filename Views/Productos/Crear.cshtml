@model ProductoFormViewModel
@{
    ViewData["Title"] = "Nuevo producto";
}
<h1 class="h3 mb-3">Nuevo producto</h1>
<div class="card" style="max-width: 820px">
    <div class="card-body">
        <form asp-action="Crear" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i>Crear producto</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto-form.js" asp-append-version="true"></script>
}
