@model ClienteFormViewModel
@{
    ViewData["Title"] = "Editar cliente";
}
<h1 class="h3 mb-3">Editar cliente</h1>
<div class="card" style="max-width: 720px">
    <div class="card-body">
        <form asp-action="Editar" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
