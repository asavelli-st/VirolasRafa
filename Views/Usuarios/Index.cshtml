@model List<UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">Usuarios</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="fa-solid fa-plus" aria-hidden="true"></i>Nuevo usuario</a>
</div>

@* En pantallas chicas, tarjetas; desde md, tabla. *@
<div class="d-md-none d-grid gap-2">
    @foreach (var u in Model)
    {
        <div class="card @(u.Activo ? "" : "opacity-75")">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-2">
                    <div class="text-break">
                        <div class="fw-semibold">@u.Nombre @if (u.EsUsuarioActual) { <span class="text-body-secondary fw-normal">(vos)</span> }</div>
                        <div class="small text-body-secondary">@u.Email</div>
                    </div>
                    <div class="text-end"><partial name="_EstadoUsuario" model="u" /></div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <partial name="_AccionesUsuario" model="u" />
                </div>
            </div>
        </div>
    }
</div>

<div class="d-none d-md-block card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol y estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.Activo ? "" : "opacity-75")">
                        <td>@u.Nombre @if (u.EsUsuarioActual) { <span class="text-body-secondary">(vos)</span> }</td>
                        <td class="text-break">@u.Email</td>
                        <td><partial name="_EstadoUsuario" model="u" /></td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <partial name="_AccionesUsuario" model="u" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
