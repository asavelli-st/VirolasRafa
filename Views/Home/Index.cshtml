@using VirolasRafa.Services.Infraestructura
@{
    ViewData["Title"] = "Inicio";
}
<h1 class="h3 mb-3">Hola, @User.FindFirst(UsuarioClaimsFactory.ClaimNombre)?.Value</h1>

<div class="row g-3">
    @if (User.IsInRole(Roles.Admin))
    {
        <div class="col-12 col-md-6 col-lg-4">
            <a class="card tarjeta-acceso h-100 text-decoration-none" asp-controller="Usuarios" asp-action="Index">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa-solid fa-users fa-2x text-primary" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">Usuarios</div>
                        <div class="small text-body-secondary">Altas, roles y contraseñas</div>
                    </div>
                </div>
            </a>
        </div>
    }
    else
    {
        <p class="text-body-secondary">Usá el menú para moverte por el sistema.</p>
    }
</div>
